<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sa</AssemblyName>
    <RootNamespace>SentimentAnalysis.Cli</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SentimentAnalysis.Application\SentimentAnalysis.Application.csproj" />
    <!-- Desktop UI kütüphanesi Avalonia'sızdır; EmotionLocalizer ve PercentFormatter buradan
         yeniden kullanılır (aynı Türkçe adlar ve aynı yüzde yuvarlaması). -->
    <ProjectReference Include="..\SentimentAnalysis.Desktop\SentimentAnalysis.Desktop.csproj" />
    <ProjectReference Include="..\SentimentAnalysis.Infrastructure.Audio\SentimentAnalysis.Infrastructure.Audio.csproj" />
    <ProjectReference Include="..\SentimentAnalysis.Infrastructure.Emotion\SentimentAnalysis.Infrastructure.Emotion.csproj" />
    <ProjectReference Include="..\SentimentAnalysis.Infrastructure.Stt\SentimentAnalysis.Infrastructure.Stt.csproj" />
    <ProjectReference Include="..\SentimentAnalysis.Infrastructure.Vad\SentimentAnalysis.Infrastructure.Vad.csproj" />
    <ProjectReference Include="..\SentimentAnalysis.Infrastructure.Storage\SentimentAnalysis.Infrastructure.Storage.csproj" />
  </ItemGroup>

</Project>
