<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SentimentAnalysis.Desktop"
        xmlns:views="using:SentimentAnalysis.Desktop.Avalonia.Views"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="SentimentAnalysis.Desktop.Avalonia.MainWindow"
        Title="SentimentAnalysis"
        Width="960" Height="640" MinWidth="720" MinHeight="480">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:LiveViewModel">
            <views:LiveView />
        </DataTemplate>
        <DataTemplate DataType="vm:ReportViewModel">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="vm:HistoryViewModel">
            <views:HistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- Navigasyon -->
        <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="SentimentAnalysis" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <Button Content="Canlı" Command="{Binding ShowLiveCommand}" />
                <Button Content="Rapor" Command="{Binding ShowReportCommand}" />
                <Button Content="Geçmiş" Command="{Binding ShowHistoryCommand}" />
                <Button Content="Ayarlar" Command="{Binding ShowSettingsCommand}" />
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentView}" Margin="16" />
    </DockPanel>
</Window>
