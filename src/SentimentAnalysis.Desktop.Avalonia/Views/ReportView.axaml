<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:desktop="clr-namespace:SentimentAnalysis.Desktop;assembly=SentimentAnalysis.Desktop"
             xmlns:conv="using:SentimentAnalysis.Desktop.Avalonia.Converters"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="SentimentAnalysis.Desktop.Avalonia.Views.ReportView">

    <UserControl.Resources>
        <conv:UncertainOpacityConverter x:Key="UncertainOpacityConverter" />
        <DataTemplate x:Key="SourcePanel" DataType="desktop:SourceAnalysisVm">
            <Border Background="{DynamicResource SubtleBg}" CornerRadius="10" Padding="12" Margin="2" MinWidth="160">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{Binding Emotion}" FontSize="18" FontWeight="Bold" />
                    <TextBlock FontSize="11" IsVisible="{Binding HasData}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="{Binding AxisSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Duyarlılık tablosunda en iyi seçeneğin değiştiği hücre vurgulanır. -->
        <Style Selector="TextBlock.changed">
            <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Rapor henüz yok. Bir oturum tamamlandığında veya Geçmiş'ten seçildiğinde burada görünür."
                   IsVisible="{Binding !HasReport}" FontStyle="Italic" Opacity="0.7" />

        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasReport}">
            <StackPanel Spacing="18" Margin="0,0,8,16">
                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Görüşme özeti" Classes="cardTitle" />
                        <TextBlock Text="{Binding DominantEmotion, StringFormat='En çok görülen duygu: {0}'}" />
                        <TextBlock Text="{Binding ValenceTrend, StringFormat='Gidişat: {0:F2}  (artı = olumluya, eksi = olumsuza gidiyor)'}" />
                        <TextBlock Text="{Binding Volatility, StringFormat='Duygu iniş-çıkışı: {0:F2}  (0 = hep aynı, 1 = çok değişken)'}" />
                        <TextBlock Text="{Binding AverageCongruence, StringFormat='Söz ile ses tonu uyumu: {0:F2}  (1 = tam uyumlu)'}" />
                        <TextBlock Text="{Binding TurkishSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 11e: görüşme sonrası karar bölümleri. Karar verisi yoksa (pencere yok) hiçbiri görünmez. -->
                <Border Classes="card" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="4,1,1,1"
                        IsVisible="{Binding HasDecisionData}">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="6" DataContext="{Binding FollowUp}">
                            <TextBlock Text="Görüşmeden sonra ne yapmalı?" Classes="cardTitle" />
                            <TextBlock Text="{Binding ProfileText}" Classes="muted" />
                            <TextBlock Text="{Binding BestText}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SystemAccentColor}" />
                            <TextBlock Text="{Binding ReasonText}" TextWrapping="Wrap" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24" Margin="0,12,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Görüşmede hangi sorunlar ne kadar görüldü?" Classes="sectionTitle" />
                                    <ItemsControl ItemsSource="{Binding MeetingIndicators}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Spacing="4" Margin="0,0,0,10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="11" Margin="8,0,0,0" />
                                                    </Grid>
                                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Value}" Height="8" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Spacing="4" IsVisible="{Binding HasRanking}">
                                        <TextBlock Text="Seçeneklerin uygunluk puanı" Classes="sectionTitle" Margin="0,8,0,0" />
                                        <TextBlock Text="Puan yüksekse o seçenek bu görüşmeye daha uygun (TOPSIS yöntemiyle hesaplanır)." Classes="muted" />
                                        <ItemsControl ItemsSource="{Binding Ranking}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="180,*,48" Margin="0,2">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Closeness}" Height="6" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Neye ne kadar önem verilsin?" Classes="sectionTitle" />
                                    <Border Classes="why">
                                        <TextBlock Text="Sistem öneri verirken altı sorunu birlikte tartar. Bir sorunun kaydırıcısını sağa çekersen sistem o soruna daha çok önem verir ve önerisi buna göre değişebilir. Yüzdeler her sorunun toplam içindeki payıdır." />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Weights}" ItemTemplate="{StaticResource WeightRow}" />
                                    <Button Content="Görüşme sonundaki ayarlara dön" Command="{Binding ResetWeightsCommand}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding DecisionSaveStatus}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap"
                                   IsVisible="{Binding DecisionSaveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding HasDecisionData}">
                    <StackPanel Spacing="6" DataContext="{Binding FollowUp}">
                        <TextBlock Text="Duyarlılık Analizi" Classes="cardTitle" />
                        <TextBlock Text="Her kriterin ağırlığı ayrı ayrı değiştirildiğinde en iyi takip seçeneği değişiyor mu?"
                                   FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SystemBaseMediumColor}" />
                        <Grid ColumnDefinitions="160,*,*,*,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Kriter" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="−%20" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="2" Text="−%10" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="3" Text="+%10" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Grid.Column="4" Text="+%20" FontWeight="SemiBold" FontSize="12" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Sensitivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="160,*" Margin="0,2">
                                        <TextBlock Text="{Binding Criterion}" FontSize="12" />
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap"
                                                               Classes.changed="{Binding Changed}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SensitivitySummary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding HasDecisionData}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Gösterge Zaman Çizelgesi" Classes="cardTitle" />
                        <!-- Satır başına kriter; hücre başına analiz penceresi. Koyuluk = gösterge değeri (0..1). -->
                        <Grid ColumnDefinitions="130,*">
                            <ItemsControl Grid.Column="0" ItemsSource="{Binding IndicatorTimeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Height="16" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding IndicatorTimeline}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Values}" Height="16">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="10" Height="14" Background="{DynamicResource SystemAccentColor}"
                                                                Opacity="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <TextBlock Text="{Binding TimelineRange}" FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}" />
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding HasDecisionData}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Görüşme sırasında verilen öneriler" Classes="cardTitle" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="60,200,*" Margin="0,3"
                                          Opacity="{Binding IsLowConfidence, Converter={StaticResource UncertainOpacityConverter}}">
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{Binding Reason}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card"
                        IsVisible="{Binding HasDecisionData}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Zorlu anlar" Classes="cardTitle" />
                        <TextBlock Text="Belirgin bir kritik an yok." FontStyle="Italic" Opacity="0.7"
                                   IsVisible="{Binding !HasCriticalMoments}" />
                        <ItemsControl ItemsSource="{Binding CriticalMoments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Duygu Payları" Classes="cardTitle" />
                        <ItemsControl ItemsSource="{Binding TimeShare}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="150,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Emotion}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Share, StringFormat='{}{0:P1}'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Konuşmacı ayrımı (10b). Durum şeridi, özellik hiç denenmediyse (boş metin)
                     görünmez; denendiyse sonucu DÜRÜSTÇE söyler — başarısızlık sessizce
                     gizlenmez (08e dersi: kullanıcı ne gördüğünü bilmeli). -->
                <Border Classes="card"
                        IsVisible="{Binding DiarizationStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Konuşmacılar" Classes="cardTitle" />
                        <TextBlock Text="{Binding DiarizationStatus}" TextWrapping="Wrap" FontStyle="Italic" Opacity="0.8" />

                        <ItemsControl ItemsSource="{Binding SpeakerLines}" IsVisible="{Binding HasSpeakers}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,120,*,20" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}" Opacity="0.7" />
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"
                                                   Opacity="{Binding Uncertain, Converter={StaticResource UncertainOpacityConverter}}" />
                                        <TextBlock Grid.Column="3" Text="?" FontWeight="Bold" FontSize="12"
                                                   IsVisible="{Binding Uncertain}"
                                                   ToolTip.Tip="Bu satırın hangi konuşmacıya ait olduğu kesin değil."
                                                   Foreground="{DynamicResource SystemAccentColor}"
                                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Konuşma dengesi (11e): konuşmacı başına süre ve pay. -->
                        <StackPanel Spacing="4" IsVisible="{Binding HasSpeakers}" Margin="0,12,0,0">
                            <TextBlock Text="Konuşma dengesi" FontWeight="SemiBold" FontSize="14" />
                            <ItemsControl ItemsSource="{Binding TalkBalance}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="120,*,140" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Share}" Height="8" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Konuşmacı-başına duygu ortalaması (10c): her konuşmacı için metin/ses/nihai. -->
                        <ItemsControl ItemsSource="{Binding SpeakerEmotions}" IsVisible="{Binding HasSpeakers}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="desktop:SpeakerEmotionVm">
                                    <StackPanel Spacing="4" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                                        <!-- Ölçüm VARSA kaç saniyeye dayandığını, YOKSA "yeterli ses yok"u
                                             söyler; satır hiçbir durumda gizlenmez — aksi halde iki durum
                                             kullanıcı için tıpatıp aynı görünürdü. -->
                                        <TextBlock FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding AudioMeasurementNote}" />
                                        <!-- Belirsiz atamalar ortalamaya girdi; yalnızca varsa bildirilir. -->
                                        <TextBlock FontSize="10" FontStyle="Italic"
                                                   Foreground="{DynamicResource SystemBaseMediumColor}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding UncertainChunkNote}"
                                                   IsVisible="{Binding HasUncertainChunks}" />
                                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                            <ContentControl Grid.Column="0" Content="{Binding TextAnalysis}"
                                                            ContentTemplate="{StaticResource SourcePanel}"
                                                            HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="1" Content="{Binding AudioAnalysis}"
                                                            ContentTemplate="{StaticResource SourcePanel}"
                                                            HorizontalContentAlignment="Stretch" />
                                            <ContentControl Grid.Column="2" Content="{Binding CombinedAnalysis}"
                                                            ContentTemplate="{StaticResource SourcePanel}"
                                                            HorizontalContentAlignment="Stretch" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Duygunun en yoğun olduğu anlar" Classes="cardTitle" />
                        <ItemsControl ItemsSource="{Binding PeakMoments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="80,110,*" Margin="0,4">
                                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:hh\\:mm\\:ss}'}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Emotion}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="2" Text="{Binding Transcript}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
