<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
             x:Class="SentimentAnalysis.Desktop.Avalonia.Views.SettingsView">

    <StackPanel Spacing="16" MaxWidth="420" HorizontalAlignment="Left">
        <TextBlock Text="Ayarlar" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Ses Saklama Süresi (gün)" />
            <TextBox Text="{Binding RetentionDays}" Watermark="7" />
        </StackPanel>

        <CheckBox Content="Sesi sakla" IsChecked="{Binding KeepAudio}" />

        <StackPanel Spacing="4">
            <TextBlock Text="Görüşme dili" />
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="200" />
        </StackPanel>

        <StackPanel Spacing="4">
            <CheckBox Content="Konuşmacı ayrımını aç" IsChecked="{Binding DiarizationEnabled}" />
            <TextBlock Text="Açıkken oturum sesi geçici olarak saklanır ve konuşmacılar analiz sonrası arka planda hesaplanır."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.7" />
        </StackPanel>

        <TextBlock Text="&quot;Sesi sakla&quot; kapalıysa kayıtlı sesler uygulama her açıldığında silinir; açıksa saklama süresi dolunca."
                   TextWrapping="Wrap" FontSize="11" Opacity="0.7" />

        <Button Content="Kaydet" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding SavedNotice}" TextWrapping="Wrap" FontSize="12"
                   IsVisible="{Binding SavedNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
</UserControl>
