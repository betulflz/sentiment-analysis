<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="SentimentAnalysis.Desktop.Avalonia.Views.LiveView">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}" IsEnabled="{Binding !IsCapturing}" />
                <TextBlock Text="{Binding SelectedFile}" VerticalAlignment="Center" FontStyle="Italic"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <Button Content="Başlat" Command="{Binding StartCommand}" IsEnabled="{Binding !IsCapturing}" />
                <Button Content="Durdur" Command="{Binding StopCommand}" IsEnabled="{Binding IsCapturing}" />
                <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4"
                        IsVisible="{Binding IsCapturing}" VerticalAlignment="Center">
                    <TextBlock Text="Dinleniyor" Foreground="White" FontSize="12" />
                </Border>
            </StackPanel>

            <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Güncel Durum" FontWeight="SemiBold" FontSize="14" />
                    <TextBlock Text="{Binding CurrentEmotion}" FontSize="24" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding CurrentValence, StringFormat='Valence: {0:F2}'}" />
                        <TextBlock Text="{Binding CurrentArousal, StringFormat='Arousal: {0:F2}'}" />
                    </StackPanel>
                    <TextBlock Text="{Binding CongruenceBadge}" Foreground="DarkOrange" FontStyle="Italic" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Timeline}" Margin="8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="8">
                                <Grid ColumnDefinitions="80,110,70,70,*">
                                    <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:hh\\:mm\\:ss}'}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Emotion}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Valence, StringFormat='V {0:F2}'}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Arousal, StringFormat='A {0:F2}'}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Transcript}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
