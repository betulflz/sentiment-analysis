<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:desktop="clr-namespace:SentimentAnalysis.Desktop;assembly=SentimentAnalysis.Desktop"
             xmlns:conv="using:SentimentAnalysis.Desktop.Avalonia.Converters"
             xmlns:ctl="using:SentimentAnalysis.Desktop.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Name="Root"
             x:Class="SentimentAnalysis.Desktop.Avalonia.Views.LiveView">

    <UserControl.Styles>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="#C0392B" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
        <conv:MeetingProfileNameConverter x:Key="ProfileName" />
        <conv:UncertainOpacityConverter x:Key="UncertainOpacity" />

        <DataTemplate x:Key="SourcePanel" DataType="desktop:SourceAnalysisVm">
            <Border Classes="card" Padding="14,12" Margin="2" MinWidth="200">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource SystemBaseMediumColor}" />
                    <TextBlock Text="{Binding Emotion}" FontSize="22" FontWeight="Bold" />

                    <ItemsControl ItemsSource="{Binding Shares}" IsVisible="{Binding HasData}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="desktop:EmotionShareVm">
                                <Grid ColumnDefinitions="Auto,*,46" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Emotion}" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent}" Height="6"
                                                 VerticalAlignment="Center" Margin="4,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat='%{0}'}"
                                               FontSize="12" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock IsVisible="{Binding !HasData}" FontStyle="Italic" FontSize="11"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="henüz ölçüm yok" />

                    <TextBlock FontSize="11" IsVisible="{Binding HasData}"
                               Foreground="{DynamicResource SystemBaseMediumColor}"
                               Text="{Binding AxisSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
            <WrapPanel Orientation="Horizontal">
                <ToggleSwitch IsChecked="{Binding UseMicrophone}"
                              OnContent="Mikrofon" OffContent="Dosya"
                              IsEnabled="{Binding !IsCapturing}" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding UseCamera}"
                              OnContent="Kamera açık" OffContent="Kamera kapalı"
                              IsEnabled="{Binding !IsCapturing}" VerticalAlignment="Center" />
                <Button Content="Dosya Seç" Command="{Binding SelectFileCommand}"
                        IsEnabled="{Binding !IsCapturing}" IsVisible="{Binding IsFileMode}" />
                <TextBlock Text="{Binding SelectedFile}" VerticalAlignment="Center" FontStyle="Italic"
                           IsVisible="{Binding IsFileMode}"
                           Foreground="{DynamicResource SystemBaseMediumColor}" />
                <Button Content="Başlat" Command="{Binding StartCommand}" IsEnabled="{Binding !IsCapturing}" />
                <Button Content="Durdur" Command="{Binding StopCommand}" IsEnabled="{Binding IsCapturing}" />
                <Border Background="{DynamicResource SystemAccentColor}" CornerRadius="4" Padding="8,4"
                        IsVisible="{Binding IsCapturing}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CaptureStatusText}" Foreground="White" FontSize="12" />
                </Border>
                <ComboBox ItemsSource="{Binding Decision.Profiles}" Margin="8,0"
                          SelectedItem="{Binding Decision.SelectedProfile, Mode=TwoWay}"
                          IsEnabled="{Binding !Decision.IsLocked}" MinWidth="160"
                          AutomationProperties.Name="Görüşme profili">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Converter={StaticResource ProfileName}}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- Konuşmacı ayrımı kişi sayısını bilirse benzer sesleri tek kişi saymaz (2026-11-09 ölçümü). -->
                <TextBlock Text="Kaç kişi konuşacak?" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox ItemsSource="{Binding SpeakerCountOptions}" SelectedItem="{Binding SelectedSpeakerCount, Mode=TwoWay}"
                          IsEnabled="{Binding !IsCapturing}" MinWidth="110" VerticalAlignment="Center"
                          AutomationProperties.Name="Kaç kişi konuşacak"
                          ToolTip.Tip="Görüşmede kaç kişi konuşacağını seçersen konuşmacılar daha doğru ayrılır. Emin değilsen 'Bilmiyorum' seç.">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>

            <!-- 12: "Sesimi tanıt" — canlı Siz / Karşı taraf ayrımı bu kayda dayanır (yalnız mikrofon/kamera). -->
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowEnrollment}">
                <Button Content="{Binding EnrollButtonText}" Command="{Binding EnrollCommand}"
                        AutomationProperties.Name="Sesimi tanıt"
                        ToolTip.Tip="Görüşmeden önce birkaç saniye yalnız siz konuşun. Böylece konuşmalar 'Siz' ve 'Karşı taraf' diye ayrılır." />
                <Button Content="Tanıtmayı sil" Command="{Binding ClearEnrollmentCommand}"
                        IsVisible="{Binding CanClearEnrollment}" AutomationProperties.Name="Ses tanıtmasını sil"
                        ToolTip.Tip="Ses imzası yalnız bu uygulama açıkken bellekte durur. Sonraki görüşmeyi başka biri yönetecekse silin." />
                <TextBlock Text="{Binding EnrollmentStatus}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                           Classes.warn="{Binding EnrollmentWarning}" MaxWidth="640" />
            </StackPanel>

            <TextBlock Text="{Binding DiarizationHint}" FontSize="11" TextWrapping="Wrap"
                       IsVisible="{Binding DiarizationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemBaseMediumColor}" FontStyle="Italic" />

            <!-- Her profilde her yüz kendi panelinde; yüz görünmeyince tek ortak kare. -->
            <ItemsControl ItemsSource="{Binding FacePanels}" IsVisible="{Binding ShowFacePanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="{Binding FacePanelColumns}" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="desktop:FacePanelVm">
                        <Border Classes="card" Margin="4" Padding="10">
                            <StackPanel Spacing="6">
                                <ctl:FaceCropImage Source="{Binding #Root.PreviewBitmap}" Box="{Binding Box}"
                                                   HorizontalAlignment="Center" />
                                <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Kişinin adı" FontWeight="SemiBold"
                                         AutomationProperties.Name="Kişinin adı"
                                         ToolTip.Tip="Bu yüze bir ad ver. Yüz numaraları kişi değil sıradır; biri çıkıp girerse karışabilir." />
                                <TextBlock Text="{Binding Emotion}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="Başını çevirme" FontSize="11" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding LookAway}" Height="6" />
                                <TextBlock Text="Olumsuz ifade" FontSize="11" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Negative}" Height="6" />
                                <TextBlock Text="Gülümseme" FontSize="11" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding Smile}" Height="6" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border IsVisible="{Binding ShowSharedPreview}" Background="#15191F" CornerRadius="6" ClipToBounds="True">
                <Viewbox Stretch="Uniform" MaxHeight="360" HorizontalAlignment="Center">
                    <Grid Width="{Binding PreviewFrame.Width}" Height="{Binding PreviewFrame.Height}">
                        <Image x:Name="PreviewImage" Stretch="Fill" />
                        <ItemsControl ItemsSource="{Binding PreviewFaces}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding W}" Height="{Binding H}" BorderBrush="#5CE0B4" BorderThickness="2">
                                        <Border Background="#C020302B" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="4,2">
                                            <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13" />
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Viewbox>
            </Border>

            <Border Classes="card" BorderBrush="{DynamicResource SystemAccentColor}" BorderThickness="4,1,1,1"
                    Opacity="{Binding Decision.IsLowConfidence, Converter={StaticResource UncertainOpacity}}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Şu an ne yapmalı?" Classes="cardTitle" />
                    <TextBlock Text="{Binding Decision.ActionText}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemAccentColor}" />
                    <TextBlock Text="{Binding Decision.ReasonText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Decision.WhyText}" TextWrapping="Wrap" FontSize="12" Classes="muted"
                               IsVisible="{Binding Decision.WhyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- 12: konuşma payı (ses tanıtıldıysa) -->
                    <StackPanel Spacing="2" IsVisible="{Binding Decision.HasTalkShare}" Margin="0,4,0,0">
                        <TextBlock Text="Konuşma payı (son 1 dakika)" FontSize="12" Classes="muted" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Decision.HostShare}" Height="8"
                                         VerticalAlignment="Center" AutomationProperties.Name="Sizin konuşma payınız" />
                            <TextBlock Grid.Column="1" Text="{Binding Decision.TalkShareText}" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                    <TextBlock Text="{Binding Decision.ConfidenceText}" FontSize="12" />
                    <TextBlock Text="{Binding Decision.AlternativeText}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="İlk analiz penceresi bekleniyor." IsVisible="{Binding Decision.ConfidenceText, Converter={x:Static StringConverters.IsNullOrEmpty}}" FontSize="12" />
                    <StackPanel Spacing="4" Margin="0,8,0,0" IsVisible="{Binding Decision.HasRanking}">
                        <TextBlock Text="Seçeneklerin uygunluk puanı" Classes="sectionTitle" />
                        <TextBlock Text="Puan yüksekse o hareket şu ana daha uygun (TOPSIS yöntemiyle hesaplanır)." Classes="muted" />
                        <ItemsControl ItemsSource="{Binding Decision.Ranking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="180,*,48" Margin="0,2">
                                        <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Closeness}" Height="6" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding PercentText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Şu an hangi sorunlar görülüyor?" Classes="sectionTitle" />
                    <TextBlock Text="Çubuk ne kadar uzunsa o sorun o kadar belirgin." Classes="muted" />
                    <ItemsControl ItemsSource="{Binding Decision.Indicators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Value}" Height="8" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Decision.Faces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,4,0,8">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                    <TextBlock Text="Başın dönüklüğü" FontSize="11" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding LookAway}" Height="6" />
                                    <TextBlock Text="Olumsuz ifade" FontSize="11" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Negative}" Height="6" />
                                    <TextBlock Text="Gülümseme" FontSize="11" />
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Smile}" Height="6" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Neye ne kadar önem verilsin?" Classes="sectionTitle" />
                    <Border Classes="why">
                        <TextBlock Text="Sistem öneri verirken altı sorunu birlikte tartar. Bir sorunun kaydırıcısını sağa çekersen sistem o soruna daha çok önem verir ve önerisi buna göre değişebilir. Yüzdeler her sorunun toplam içindeki payıdır." />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Decision.Weights}" ItemTemplate="{StaticResource WeightRow}" />
                    <Button Content="Varsayılana dön" Command="{Binding Decision.ResetWeightsCommand}" />
                </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                <ContentControl Grid.Column="0" Content="{Binding TextAnalysis}"
                                ContentTemplate="{StaticResource SourcePanel}"
                                HorizontalContentAlignment="Stretch" />
                <ContentControl Grid.Column="1" Content="{Binding AudioAnalysis}"
                                ContentTemplate="{StaticResource SourcePanel}"
                                HorizontalContentAlignment="Stretch" />
                <ContentControl Grid.Column="2" Content="{Binding FinalAnalysis}"
                                ContentTemplate="{StaticResource SourcePanel}"
                                HorizontalContentAlignment="Stretch" />
            </Grid>
            <TextBlock Text="{Binding FaceContributionText}" FontSize="12"
                       IsVisible="{Binding FaceContributionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource SystemBaseMediumColor}" />

            <!-- Uyumsuzluk sinyali: tek yüksek-sesli öğe. Rozet boşsa şerit tamamen çöker. -->
            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0" Background="{DynamicResource SystemBaseLowColor}" CornerRadius="4"
                        Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentConfidence, StringFormat='Güven: {0}'}" FontSize="11" />
                </Border>
                <Border Grid.Column="1" Margin="8,0,0,0" Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="4" Padding="10,4" VerticalAlignment="Stretch"
                        IsVisible="{Binding CongruenceBadge, Converter={StaticResource StringNotEmptyConverter}}">
                    <TextBlock Text="{Binding CongruenceBadge}" Foreground="White" FontWeight="SemiBold"
                               FontSize="12" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <!-- Yakalama hatası (ör. reddedilen mikrofon izni): tam metin, sarmalı — küçük rozette kırpılmasın. -->
            <Border Background="#D13438" CornerRadius="4" Padding="10,8"
                    IsVisible="{Binding CaptureError, Converter={StaticResource StringNotEmptyConverter}}">
                <TextBlock Text="{Binding CaptureError}" Foreground="White" TextWrapping="Wrap" FontSize="12" />
            </Border>

            <!-- Atlanan chunk uyarısı (kanal taşması / drenaj sınırı): sessizce yutulmaz, ama
                 alarm değil dipnot niteliğinde — sıfırsa şerit tamamen çöker. -->
            <TextBlock FontSize="11" FontStyle="Italic" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="{Binding SkippedChunksNotice}"
                       IsVisible="{Binding SkippedChunksNotice, Converter={StaticResource StringNotEmptyConverter}}" />

            <TextBlock FontSize="10" FontStyle="Italic" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="Yüzdeler kesin olasılık değildir; o anki duygunun her duyguya ne kadar benzediğini gösterir." />
        </StackPanel>

        <Border Classes="card" Padding="4" MinHeight="200">
            <Grid>
            <TextBlock IsVisible="{Binding WaitingForSpeech}" Margin="16" TextWrapping="Wrap" FontStyle="Italic"
                       VerticalAlignment="Top" Foreground="{DynamicResource SystemBaseMediumColor}"
                       Text="Konuşma bekleniyor… Sessiz bölümler analiz edilmez; ilk satır, konuşma içeren ilk parça işlenince gelir." />
            <ItemsControl ItemsSource="{Binding Timeline}" Margin="8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource SystemBaseLowColor}" BorderThickness="0,0,0,1" Padding="8">
                            <Grid ColumnDefinitions="80,100,180,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat='{}{0:hh\\:mm\\:ss}'}"
                                           FontSize="11" Foreground="{DynamicResource SystemBaseMediumColor}"
                                           VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <!-- 12: kim konuştu (ses tanıtıldıysa) -->
                                    <Border IsVisible="{Binding HasWho}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left"
                                            Background="{DynamicResource SystemBaseLowColor}">
                                        <TextBlock Text="{Binding Who}" FontSize="10" />
                                    </Border>
                                    <TextBlock Text="{Binding Emotion}" FontWeight="SemiBold" />
                                </StackPanel>
                                <!-- Eksen özeti + girdi kalitesi: "neden bu sonuç?" sorusunun ilk durağı. -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding AxisSummary}" FontSize="11"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding QualityNote}" FontSize="10"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding FaceNote}" FontSize="10"
                                               IsVisible="{Binding FaceNote, Converter={StaticResource StringNotEmptyConverter}}"
                                               Foreground="{DynamicResource SystemBaseMediumColor}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Girdi zayıf — bu satır temkinli okunmalı."
                                               IsVisible="{Binding WeakInput}" FontSize="10"
                                               Foreground="{DynamicResource SystemAccentColor}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="3" IsVisible="{Binding Flagged}"
                                        Background="{DynamicResource SystemAccentColor}" CornerRadius="4"
                                        Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11" />
                                </Border>
                                <TextBlock Grid.Column="4" Text="{Binding Transcript}" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </Border>
    </DockPanel>
    </ScrollViewer>
</UserControl>
